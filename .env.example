# 服务配置
CONSOLE_WEB_URL=https://dify.local.example.com
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U
TENANT_ID=47f8b62e-5041-4f16-a728-5064d48d6536
EDITION=SELF_HOSTED
ACCOUNT_DEFAULT_ROLE=normal

# 令牌配置
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_PREFIX=refresh_token:
ACCOUNT_REFRESH_TOKEN_PREFIX=account_refresh_token:

# 服务时区，IANA tz 名称，常用：Asia/Shanghai / UTC / America/New_York
TIMEZONE=Asia/Shanghai

# OIDC配置
OIDC_CLIENT_ID=798189a637c07e07260f
OIDC_CLIENT_SECRET=413dfa65cee3ebf2eb9d3a3f841a325705ae2394
OIDC_DISCOVERY_URL=https://auth.local.example.com/.well-known/openid-configuration
OIDC_REDIRECT_URI=https://dify.local.example.com/console/api/enterprise/sso/oidc/callback
OIDC_SCOPE=openid profile email roles
OIDC_RESPONSE_TYPE=code

# 数据库配置
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# Redis配置
REDIS_SERIALIZATION_PROTOCOL=2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=difyai123456

# Dify 版本对齐
# 对应 dify/api/constants/dsl_version.py 中的 CURRENT_APP_DSL_VERSION，升级 Dify 后请同步更新
# Dify 1.13.x -> 0.4.0 之类的旧值；Dify 1.14.0 -> 0.6.0
APP_DSL_VERSION=0.6.0

# 兼容老版本 Dify
# Dify 1.14.0 起 /features 中 knowledge_rate_limit 改为 int，1.13.x 仍是 {limit, subscription_plan} 对象
# 1.13.x 用户置 true；1.14.0+ 用户保持 false
LEGACY_KNOWLEDGE_RATE_LIMIT_AS_OBJECT=false

# 插件安装来源
# true: 允许从市场 + GitHub + 本地上传安装插件
# false: 仅允许从市场安装
PLUGIN_ALLOW_ALL_SOURCES=true
# 插件来源白名单范围: none / official_only / official_and_specific_partners / all
PLUGIN_INSTALLATION_SCOPE=all

# 登录方式
# 是否显示 SSO 按钮（控制台 + Webapp 共用）。true 时显示；与密码登录可并存
SSO_ENFORCED_FOR_SIGNIN=true
# SSO 协议，目前仅实现 OIDC
SSO_PROTOCOL=oidc
# 是否启用邮箱+密码登录
ENABLE_EMAIL_PASSWORD_LOGIN=true
# 是否启用邮箱验证码登录
ENABLE_EMAIL_CODE_LOGIN=false
# 是否启用社交 OAuth 登录（GitHub/Google 等）
ENABLE_SOCIAL_OAUTH_LOGIN=false
# 是否允许用户自助注册
IS_ALLOW_REGISTER=false
# 是否允许用户创建新工作区
IS_ALLOW_CREATE_WORKSPACE=true

# Webapp 应用层访问控制提示（不影响 webapp 登录页 SSO 按钮显示）
# webapp 登录页 SSO 按钮由 SSO_ENFORCED_FOR_SIGNIN 控制，
# 以下三个仅供「应用访问控制」模块的提示文案使用
WEBAPP_ALLOW_SSO=true
WEBAPP_ALLOW_EMAIL_PASSWORD_LOGIN=true
WEBAPP_ALLOW_EMAIL_CODE_LOGIN=false

# Dify api 容器在 docker 网络中的内部地址（用于 apps 接口反代注入 access_mode）
# 默认 http://api:5001，与 Dify 官方 docker-compose 服务名一致
# 若 api 服务名不同或外部部署，改成对应可达地址
DIFY_API_INTERNAL_URL=http://api:5001
