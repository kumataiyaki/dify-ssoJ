# ============================================================
# dify-sso 環境変数のサンプル（日本語コメントはこのフォークで追加）
# 使い方: cp .env.example .env して値を書き換えます。詳しくは docs/SETUP_ja.md
# 注意: docker run --env-file は「=」より後ろをすべて値として扱います。
#       値を引用符で囲まない／値の後ろにコメントを書かないでください。
# ここにある値はすべてダミーです。
# ============================================================

# ---- サービス設定 ----
# 服务配置
# ブラウザで開く Dify の URL（末尾の / は不要）。https で始まると Secure 属性と __Host- 付きの Cookie が追加されます
CONSOLE_WEB_URL=https://dify.local.example.com
# Dify の docker/.env にある SECRET_KEY と同じ値にします（トークンの署名に使います）
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U
# SSO ユーザーを参加させるワークスペースの ID（SELECT id,name FROM tenants; で確認します）
TENANT_ID=47f8b62e-5041-4f16-a728-5064d48d6536
# SELF_HOSTED のまま
EDITION=SELF_HOSTED
# 初めてワークスペースに参加するユーザーのロール: normal / editor / admin（無効な値の場合は normal）
# IdP の userinfo のトップレベルに roles（admin/editor/normal）があれば、そちらが優先されます
ACCOUNT_DEFAULT_ROLE=normal

# ---- トークン設定（通常は変更不要） ----
# 令牌配置
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_PREFIX=refresh_token:
ACCOUNT_REFRESH_TOKEN_PREFIX=account_refresh_token:

# ---- タイムゾーン ----
# 日本で使う場合は Asia/Tokyo にしてください（コード上の既定値は Asia/Tokyo ですが、このサンプルは Asia/Shanghai になっています）
# ログの時刻は別の変数 LOG_TZ（既定値 UTC）で決まります
# 服务时区，IANA tz 名称，常用：Asia/Shanghai / UTC / America/New_York
TIMEZONE=Asia/Shanghai

# ---- OIDC 設定（Keycloak の例は docs/SETUP_ja.md の A-5） ----
# OIDC配置
OIDC_CLIENT_ID=798189a637c07e07260f
OIDC_CLIENT_SECRET=413dfa65cee3ebf2eb9d3a3f841a325705ae2394
# Keycloak の例: https://<keycloak>/realms/<realm>/.well-known/openid-configuration
# dify-sso は起動時にこの URL へ接続します。社内 CA の証明書を使っている場合は docs/SETUP_ja.md の B 章を参照してください
OIDC_DISCOVERY_URL=https://auth.local.example.com/.well-known/openid-configuration
# {Dify の URL}/console/api/enterprise/sso/oidc/callback。IdP 側に登録する値と完全に一致させます
OIDC_REDIRECT_URI=https://dify.local.example.com/console/api/enterprise/sso/oidc/callback
# Keycloak で roles スコープがない場合は roles を外します
OIDC_SCOPE=openid profile email roles
OIDC_RESPONSE_TYPE=code

# ---- データベース設定（Dify の docker/.env と同じ値にします。DB_HOST は Compose のサービス名） ----
# 数据库配置
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# ---- Redis 設定（Dify の docker/.env と同じ値にします。REDIS_DB も Dify と同じ番号を推奨） ----
# Redis配置
REDIS_SERIALIZATION_PROTOCOL=2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=difyai123456

# ---- Dify のバージョンに合わせる設定 ----
# APP_DSL_VERSION: Dify の api/constants/dsl_version.py にある CURRENT_APP_DSL_VERSION の値
# Dify 版本对齐
# 对应 dify/api/constants/dsl_version.py 中的 CURRENT_APP_DSL_VERSION，升级 Dify 后请同步更新
# Dify 1.13.x -> 0.4.0 之类的旧值；Dify 1.14.0 -> 0.6.0
APP_DSL_VERSION=0.6.0

# Dify 1.13.x は true、1.14.0 以降は false
# 兼容老版本 Dify
# Dify 1.14.0 起 /features 中 knowledge_rate_limit 改为 int，1.13.x 仍是 {limit, subscription_plan} 对象
# 1.13.x 用户置 true；1.14.0+ 用户保持 false
LEGACY_KNOWLEDGE_RATE_LIMIT_AS_OBJECT=false

# ---- プラグインのインストール元 ----
# PLUGIN_ALLOW_ALL_SOURCES: true = マーケットプレイス + GitHub + ローカル、false = マーケットプレイスのみ
# PLUGIN_INSTALLATION_SCOPE: none / official_only / official_and_specific_partners / all
# 插件安装来源
# true: 允许从市场 + GitHub + 本地上传安装插件
# false: 仅允许从市场安装
PLUGIN_ALLOW_ALL_SOURCES=true
# 插件来源白名单范围: none / official_only / official_and_specific_partners / all
PLUGIN_INSTALLATION_SCOPE=all

# ---- ログイン方法 ----
# SSO_ENFORCED_FOR_SIGNIN: true で SSO ボタンを表示（コンソールと WebApp 共通）。パスワードログインとは併用できます
# SSO_PROTOCOL: oidc のみ実装されています
# ENABLE_EMAIL_PASSWORD_LOGIN / ENABLE_EMAIL_CODE_LOGIN / ENABLE_SOCIAL_OAUTH_LOGIN: それぞれのログイン方法の有効・無効
# IS_ALLOW_REGISTER: セルフ登録を許可するか / IS_ALLOW_CREATE_WORKSPACE: ワークスペースの作成を許可するか
# 登录方式
# 是否显示 SSO 按钮（控制台 + Webapp 共用）。true 时显示；与密码登录可并存
SSO_ENFORCED_FOR_SIGNIN=true
# SSO 协议，目前仅实现 OIDC
SSO_PROTOCOL=oidc
# 是否启用邮箱+密码登录
ENABLE_EMAIL_PASSWORD_LOGIN=true
# 是否启用邮箱验证码登录
ENABLE_EMAIL_CODE_LOGIN=false
# 是否启用社交 OAuth 登录（GitHub/Google 等）
ENABLE_SOCIAL_OAUTH_LOGIN=false
# 是否允许用户自助注册
IS_ALLOW_REGISTER=false
# 是否允许用户创建新工作区
IS_ALLOW_CREATE_WORKSPACE=true

# ---- WebApp のアクセス制御で表示する案内（WebApp ログイン画面の SSO ボタンには影響しません） ----
# Webapp 应用层访问控制提示（不影响 webapp 登录页 SSO 按钮显示）
# webapp 登录页 SSO 按钮由 SSO_ENFORCED_FOR_SIGNIN 控制，
# 以下三个仅供「应用访问控制」模块的提示文案使用
WEBAPP_ALLOW_SSO=true
WEBAPP_ALLOW_EMAIL_PASSWORD_LOGIN=true
WEBAPP_ALLOW_EMAIL_CODE_LOGIN=false

# ---- Dify api コンテナの内部 URL（/console/api/apps のプロキシで使用。通常は http://api:5001 のまま） ----
# Dify api 容器在 docker 网络中的内部地址（用于 apps 接口反代注入 access_mode）
# 默认 http://api:5001，与 Dify 官方 docker-compose 服务名一致
# 若 api 服务名不同或外部部署，改成对应可达地址
DIFY_API_INTERNAL_URL=http://api:5001
